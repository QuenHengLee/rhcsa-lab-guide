# shellcheck shell=bash
# Source: RH134 ch.3.2 "Schedule a Future User Job"
LAB_TITLE="Schedule a one-off job with at"
LAB_TOPIC="06 scheduling-and-services"
LAB_NODE="servera"

LAB_U=sched1

lab_describe() {
    cat <<'EOF'
  The user sched1 already exists, and the atd service is running.

  Schedule a ONE-OFF job, owned by sched1, that runs

      /usr/bin/logger "at job from the RHCSA lab"

  at 16:00 tomorrow.

  It must be a single future job in the "at" queue - not a cron entry,
  and not repeating. Verify with "atq" and "at -c <jobnumber>".

  ----- 中文說明 -----

  使用者 sched1 已存在,atd 服務正在執行。

  排定一個屬於 sched1 的「一次性」工作,在明天 16:00 執行:

      /usr/bin/logger "at job from the RHCSA lab"

  它必須是 at 佇列中的單一一筆未來工作——不是 cron 項目,也不會
  重複執行。用「atq」與「at -c <工作編號>」驗證。
EOF
}

_job_id() {
    atq 2>/dev/null | awk -v u="$LAB_U" '$NF == u { print $1; exit }'
}

_has_job() { [ -n "$(_job_id)" ]; }

_time_ok() {
    local want
    want=$(date -d tomorrow '+%a %b %e')
    atq 2>/dev/null | awk -v u="$LAB_U" '$NF == u' | grep -q "$want 16:00:00"
}

_cmd_ok() {
    local id
    id=$(_job_id) || return 1
    [ -n "$id" ] || return 1
    at -c "$id" 2>/dev/null | grep -q 'logger.*at job from the RHCSA lab'
}

_one_job_only() {
    [ "$(atq 2>/dev/null | awk -v u="$LAB_U" '$NF == u' | wc -l)" = "1" ]
}

_flush_queue() {
    local id
    for id in $(atq 2>/dev/null | awk -v u="$LAB_U" '$NF == u { print $1 }'); do
        atrm "$id" 2>/dev/null
    done
    return 0
}

lab_setup() {
    lab_ensure_pkg at
    systemctl enable --now atd >/dev/null 2>&1
    if id "$LAB_U" >/dev/null 2>&1; then _flush_queue; fi
    lab_user_del "$LAB_U"
    useradd -m "$LAB_U" || return 1
    return 0
}

lab_grade() {
    grade_check "atd is running" 'systemctl is-active --quiet atd'
    grade_test "sched1 has a job in the at queue" _has_job
    grade_test "exactly one job is queued for sched1" _one_job_only
    grade_test "it is scheduled for 16:00 tomorrow" _time_ok
    grade_test "it runs the required logger command" _cmd_ok
}

lab_finish() {
    _flush_queue
    lab_user_del "$LAB_U"
    return 0
}
